<!DOCTYPE html>

<html lang="pt-BR">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <!-- SEO -->

    <title>
        @(ViewData["Title"] ?? "Porta GamerX")
    </title>

    <meta name="description"
          content="@(ViewData["Description"] ?? "Porta GamerX - Loja Online de Jogos.")" />

    <meta name="keywords"
          content="@(ViewData["Keywords"] ?? "jogos, video games, portagamerx")" />

    <meta name="author"
          content="Pimenta Selvagem" />

    <meta name="robots"
          content="index,follow" />

    <meta name="theme-color"
          content="#d63384" />

    <!-- Canonical -->
    @if (ViewData["Canonical"] != null)
    {
        <link rel="canonical"
              href="@ViewData["Canonical"]" />
    }

    <!-- Open Graph -->

    <meta property="og:type"
          content="website" />

    <meta property="og:site_name"
          content="Pimenta Selvagem" />

    <meta property="og:title"
          content="@(ViewData["Title"] ?? "Porta GamerX")" />

    <meta property="og:description"
          content="@(ViewData["Description"] ?? "Porta GamerX - Loja Online de Jogos")" />

    <meta property="og:url"
          content="@($"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}")" />

    <meta property="og:image"
          content="@(ViewData["OgImage"] ?? Url.Content("~/images/logo-og.jpg"))" />

    <!-- Twitter -->

    <meta name="twitter:card"
          content="summary_large_image" />

    <meta name="twitter:title"
          content="@(ViewData["Title"] ?? "Porta GamerX")" />

    <meta name="twitter:description"
          content="@(ViewData["Description"] ?? "Porta GamerX - Loja Online de Jogos")" />

    <meta name="twitter:image"
          content="@(ViewData["OgImage"] ?? Url.Content("~/images/logo-og.jpg"))" />

    <!-- Favicon -->

    <link rel="icon"
          type="image/png"
          href="~/Logo.png" />


    @await Html.PartialAsync("Layout/_Styles")
    @await RenderSectionAsync("Head", required: false)
</head>
<body>

    <!-- HEADER -->
    @await Html.PartialAsync("Layout/_Header")

    <!-- MENU CATEGORIAS -->
    @await Html.PartialAsync("Layout/_CategoryNav")

    <!-- MENU MOBILE -->
    @await Html.PartialAsync("Layout/_MobileMenu")

    <!-- CONTEÚDO -->

    <main role="main">

        @RenderBody()

    </main>

    <!-- FOOTER -->
    @await Html.PartialAsync("Layout/_Footer")

    <!-- SCRIPTS -->
    @await Html.PartialAsync("Layout/_Scripts")

    @await RenderSectionAsync("Scripts", required: false)

    <div id="toastContainer"
         class="toast-container position-fixed bottom-0 end-0 p-3"
         style="z-index:99999">
    </div>

</body>

</html>