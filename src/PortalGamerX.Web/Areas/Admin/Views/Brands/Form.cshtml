@model BrandForm
@{ ViewData["Title"] = Model.Id.HasValue ? "Editar publicadora" : "Nova publicadora"; }
<h1 class="h3 mb-3">@ViewData["Title"]</h1>
<form method="post" class="card stat-card" style="max-width:520px"><div class="card-body">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="Id" />
    <div class="mb-3"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" maxlength="100" /><span asp-validation-for="Name" class="text-danger small"></span></div>
    <div class="form-check mb-3"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label"></label></div>
    <button class="btn btn-primary">Salvar</button> <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
</div></form>
