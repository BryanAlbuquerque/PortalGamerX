@model List<Coupon>
@{
    ViewData["Title"] = "Cupons";
    var st = await Store.GetAsync();
    var usage = ViewBag.Usage as Dictionary<int, int> ?? new Dictionary<int, int>();
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Cupons</h1>
    <a class="btn btn-primary" asp-action="Create">Novo cupom</a>
</div>
<div class="table-responsive bg-white rounded shadow-sm">
    <table class="table align-middle mb-0">
        <thead><tr><th>Código</th><th>Desconto</th><th>Validade</th><th class="text-end">Usos</th><th>Status</th><th></th></tr></thead>
        <tbody>
        @foreach (var c in Model)
        {
            var used = usage.TryGetValue(c.Id, out var n) ? n : 0;
            <tr>
                <td><a asp-action="Edit" asp-route-id="@c.Id"><strong>@c.Code</strong></a><div class="small text-muted">@c.Description</div></td>
                <td>@(c.DiscountType == DiscountType.Percentage ? c.Value.Dec() + "%" : c.Value.ToBrl())</td>
                <td class="small">@Store.Fmt(c.StartsAtUtc, st, false) → @Store.Fmt(c.EndsAtUtc, st, false)</td>
                <td class="text-end">@used@(c.MaxUses.HasValue ? " / " + c.MaxUses : "")</td>
                <td>@if (c.IsActive) { <span class="badge text-bg-success">Ativo</span> } else { <span class="badge text-bg-secondary">Inativo</span> }</td>
                <td class="text-end text-nowrap">
                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@c.Id">Editar</a>
                    <form asp-action="Toggle" asp-route-id="@c.Id" method="post" class="d-inline"><button class="btn btn-sm btn-outline-secondary">@(c.IsActive ? "Desativar" : "Ativar")</button></form>
                    <form asp-action="Delete" asp-route-id="@c.Id" method="post" class="d-inline" data-confirm="Excluir o cupom '@c.Code'?"><button class="btn btn-sm btn-outline-danger">Excluir</button></form>
                </td>
            </tr>
        }
        @if (Model.Count == 0) { <tr><td colspan="6" class="text-center text-muted py-4">Nenhum cupom cadastrado.</td></tr> }
        </tbody>
    </table>
</div>
