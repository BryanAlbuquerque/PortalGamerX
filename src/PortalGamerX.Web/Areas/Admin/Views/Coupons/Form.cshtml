@model CouponForm
@{ ViewData["Title"] = Model.Id.HasValue ? "Editar cupom" : "Novo cupom"; }
<h1 class="h3 mb-3">@ViewData["Title"]</h1>
<form method="post" class="card stat-card" style="max-width:760px"><div class="card-body">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="Id" />
    <div class="row g-3">
        <div class="col-md-6"><label asp-for="Code" class="form-label"></label><input asp-for="Code" class="form-control text-uppercase" maxlength="50" /><span asp-validation-for="Code" class="text-danger small"></span></div>
        <div class="col-md-6"><label asp-for="Description" class="form-label"></label><input asp-for="Description" class="form-control" maxlength="200" /></div>
        <div class="col-md-4"><label asp-for="DiscountType" class="form-label"></label>
            <select asp-for="DiscountType" class="form-select">
                <option value="@DiscountType.Percentage">Percentual (%)</option>
                <option value="@DiscountType.FixedAmount">Valor fixo (R$)</option>
            </select></div>
        <div class="col-md-4"><label asp-for="Value" class="form-label"></label><input asp-for="Value" type="text" inputmode="decimal" class="form-control" value="@Model.Value.Dec()" /><span asp-validation-for="Value" class="text-danger small"></span></div>
        <div class="col-md-4"><label asp-for="MaxDiscountAmount" class="form-label"></label><input asp-for="MaxDiscountAmount" type="text" inputmode="decimal" class="form-control" value="@Model.MaxDiscountAmount.Dec()" /></div>
        <div class="col-md-6"><label asp-for="StartsAtLocal" class="form-label"></label><input asp-for="StartsAtLocal" type="datetime-local" class="form-control" value="@Model.StartsAtLocal.ToInput()" /></div>
        <div class="col-md-6"><label asp-for="EndsAtLocal" class="form-label"></label><input asp-for="EndsAtLocal" type="datetime-local" class="form-control" value="@Model.EndsAtLocal.ToInput()" /><span asp-validation-for="EndsAtLocal" class="text-danger small"></span></div>
        <div class="col-md-4"><label asp-for="MinOrderAmount" class="form-label"></label><input asp-for="MinOrderAmount" type="text" inputmode="decimal" class="form-control" value="@Model.MinOrderAmount.Dec()" /></div>
        <div class="col-md-4"><label asp-for="MaxUses" class="form-label"></label><input asp-for="MaxUses" type="number" min="1" class="form-control" /></div>
        <div class="col-md-4"><label asp-for="MaxUsesPerCustomer" class="form-label"></label><input asp-for="MaxUsesPerCustomer" type="number" min="1" class="form-control" /></div>
        <div class="col-md-6"><label asp-for="CategoryIds" class="form-label"></label>
            <select asp-for="CategoryIds" class="form-select" asp-items="Model.Categories" multiple size="6"></select></div>
        <div class="col-md-6"><label asp-for="Skus" class="form-label"></label><textarea asp-for="Skus" class="form-control" rows="4"></textarea></div>
        <div class="col-12"><div class="form-check"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label"></label></div></div>
    </div>
    <div class="mt-4"><button class="btn btn-primary">Salvar</button> <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a></div>
</div></form>
