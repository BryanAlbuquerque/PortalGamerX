@model List<Category>
@{
    ViewData["Title"] = "Categorias";
    var counts = ViewBag.Counts as Dictionary<int, int> ?? new Dictionary<int, int>();
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Categorias</h1>
    <a class="btn btn-primary" asp-action="Create">Nova categoria</a>
</div>
<div class="table-responsive bg-white rounded shadow-sm">
    <table class="table align-middle mb-0">
        <thead><tr><th>Nome</th><th>Categoria pai</th><th>Ordem</th><th class="text-end">Jogos</th><th>Status</th><th></th></tr></thead>
        <tbody>
        @foreach (var c in Model)
        {
            var n = counts.TryGetValue(c.Id, out var v) ? v : 0;
            <tr>
                <td><a asp-action="Edit" asp-route-id="@c.Id">@c.Name</a></td>
                <td class="small">@(c.Parent?.Name ?? "-")</td>
                <td>@c.SortOrder</td>
                <td class="text-end">@n</td>
                <td>@if (c.IsActive) { <span class="badge text-bg-success">Ativa</span> } else { <span class="badge text-bg-secondary">Inativa</span> }</td>
                <td class="text-end text-nowrap">
                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@c.Id">Editar</a>
                    <form asp-action="Toggle" asp-route-id="@c.Id" method="post" class="d-inline"><button class="btn btn-sm btn-outline-secondary">@(c.IsActive ? "Desativar" : "Ativar")</button></form>
                    <form asp-action="Delete" asp-route-id="@c.Id" method="post" class="d-inline" data-confirm="Excluir a categoria '@c.Name'?"><button class="btn btn-sm btn-outline-danger">Excluir</button></form>
                </td>
            </tr>
        }
        @if (Model.Count == 0) { <tr><td colspan="6" class="text-center text-muted py-4">Nenhuma categoria cadastrada.</td></tr> }
        </tbody>
    </table>
</div>
