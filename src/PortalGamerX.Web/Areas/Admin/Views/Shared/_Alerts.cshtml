@if (TempData["Success"] is string ok)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">@ok<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button></div>
}
@if (TempData["Error"] is string err)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">@err<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button></div>
}
@if (TempData["Info"] is string info)
{
    <div class="alert alert-info alert-dismissible fade show" role="alert">@info<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button></div>
}
