@model PagerVm
@if (Model.TotalPages > 1)
{
    var start = Math.Max(1, Model.Page - 2);
    var end = Math.Min(Model.TotalPages, Model.Page + 2);
    <nav aria-label="Paginação">
        <ul class="pagination justify-content-center">
            <li class="page-item @(Model.Page <= 1 ? "disabled" : "")"><a class="page-link" href="@(Model.BaseUrl)page=@(Model.Page - 1)">Anterior</a></li>
            @for (var i = start; i <= end; i++)
            {
                <li class="page-item @(i == Model.Page ? "active" : "")"><a class="page-link" href="@(Model.BaseUrl)page=@i">@i</a></li>
            }
            <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")"><a class="page-link" href="@(Model.BaseUrl)page=@(Model.Page + 1)">Próxima</a></li>
        </ul>
    </nav>
}
