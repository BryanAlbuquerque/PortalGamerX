@{
    var s = await Store.GetAsync();
    string SafeColor(string? c, string d) => System.Text.RegularExpressions.Regex.IsMatch(c ?? "", "^#[0-9a-fA-F]{6}$") ? c! : d;
    var title = ViewData["Title"] as string;
    var controller = (ViewContext.RouteData.Values["controller"] as string) ?? "";
    string Active(string c) => string.Equals(controller, c, StringComparison.OrdinalIgnoreCase) ? "active" : "";
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>@(string.IsNullOrEmpty(title) ? "Painel" : title) - Painel @s.StoreName</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <style>
        :root { --brand: @SafeColor(s.PrimaryColor, "#0d6efd"); --brand-dark: @SafeColor(s.SecondaryColor, "#212529"); --accent: @SafeColor(s.AccentColor, "#ff6b35"); }
    </style>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="admin-body">
<div class="container-fluid">
    <div class="row">
        <aside class="col-md-3 col-lg-2 admin-sidebar p-3">
            <a class="d-block text-white fw-bold fs-5 text-decoration-none mb-2" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Painel Admin</a>
            <div class="small text-secondary mb-3">@s.StoreName</div>
            <nav class="nav flex-column">
                <a class="nav-link @Active("Dashboard")" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
                <div class="nav-heading">Catálogo</div>
                <a class="nav-link @Active("Jogos")" asp-area="Admin" asp-controller="Jogos" asp-action="Index">Jogos</a>
                <a class="nav-link @Active("Categories")" asp-area="Admin" asp-controller="Categories" asp-action="Index">Categorias</a>
                <a class="nav-link @Active("Brands")" asp-area="Admin" asp-controller="Brands" asp-action="Index">Publicadoras</a>
                <a class="nav-link @Active("Stock")" asp-area="Admin" asp-controller="Stock" asp-action="Index">Estoque de keys</a>
                <div class="nav-heading">Vendas</div>
                <a class="nav-link @Active("Orders")" asp-area="Admin" asp-controller="Orders" asp-action="Index">Pedidos</a>
                <a class="nav-link @Active("Customers")" asp-area="Admin" asp-controller="Customers" asp-action="Index">Clientes</a>
                <a class="nav-link @Active("Coupons")" asp-area="Admin" asp-controller="Coupons" asp-action="Index">Cupons</a>
                <div class="nav-heading">Loja</div>
                <a class="nav-link @Active("Banners")" asp-area="Admin" asp-controller="Banners" asp-action="Index">Banners</a>
                <a class="nav-link @Active("Settings")" asp-area="Admin" asp-controller="Settings" asp-action="Index">Configurações</a>
                <a class="nav-link @Active("Audit")" asp-area="Admin" asp-controller="Audit" asp-action="Index">Auditoria</a>
            </nav>
            <hr class="border-secondary" />
            <a class="nav-link text-white-50 px-0" href="/" target="_blank" rel="noopener">Ver loja ↗</a>
            <div class="small text-secondary mt-2">@User.Identity?.Name</div>
            <form method="post" action="/conta/sair" class="mt-1">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-sm btn-outline-light">Sair</button>
            </form>
        </aside>
        <main class="col-md-9 col-lg-10 p-4">
            <partial name="_Alerts" />
            @RenderBody()
        </main>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
