@model VisualSettingsForm
@{ ViewData["Title"] = "Configurações - Identidade visual"; }
<h1 class="h3 mb-3">Configurações</h1>
<partial name="_SettingsNav" />
<form method="post" enctype="multipart/form-data" class="card stat-card"><div class="card-body">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="row g-3">
        <div class="col-md-4"><label asp-for="PrimaryColor" class="form-label"></label><input asp-for="PrimaryColor" type="color" class="form-control form-control-color" /></div>
        <div class="col-md-4"><label asp-for="SecondaryColor" class="form-label"></label><input asp-for="SecondaryColor" type="color" class="form-control form-control-color" /></div>
        <div class="col-md-4"><label asp-for="AccentColor" class="form-label"></label><input asp-for="AccentColor" type="color" class="form-control form-control-color" /></div>
        <div class="col-md-6">
            <label class="form-label" for="LogoFile">Logo</label>
            @if (!string.IsNullOrEmpty(Model.LogoPath)) { <div class="mb-2"><img src="@Model.LogoPath" alt="Logo atual" style="max-height:60px" class="bg-light border rounded p-1" /></div> }
            <input type="file" name="LogoFile" id="LogoFile" class="form-control" accept="image/jpeg,image/png,image/webp,image/gif" />
            @if (!string.IsNullOrEmpty(Model.LogoPath)) { <div class="form-check mt-1"><input asp-for="RemoveLogo" class="form-check-input" /><label asp-for="RemoveLogo" class="form-check-label">Remover logo</label></div> }
        </div>
        <div class="col-md-6">
            <label class="form-label" for="FaviconFile">Favicon</label>
            @if (!string.IsNullOrEmpty(Model.FaviconPath)) { <div class="mb-2"><img src="@Model.FaviconPath" alt="Favicon atual" style="max-height:32px" /></div> }
            <input type="file" name="FaviconFile" id="FaviconFile" class="form-control" accept="image/png,image/x-icon,image/webp" />
            @if (!string.IsNullOrEmpty(Model.FaviconPath)) { <div class="form-check mt-1"><input asp-for="RemoveFavicon" class="form-check-input" /><label asp-for="RemoveFavicon" class="form-check-label">Remover favicon</label></div> }
        </div>
        <div class="col-12"><label asp-for="FooterText" class="form-label"></label><textarea asp-for="FooterText" class="form-control" rows="2"></textarea></div>
        <div class="col-12"><label asp-for="AboutText" class="form-label"></label><textarea asp-for="AboutText" class="form-control" rows="5"></textarea></div>
        <div class="col-12"><label asp-for="DeliveryPolicyText" class="form-label"></label><textarea asp-for="DeliveryPolicyText" class="form-control" rows="5"></textarea></div>
        <div class="col-12"><label asp-for="ReturnPolicyText" class="form-label"></label><textarea asp-for="ReturnPolicyText" class="form-control" rows="5"></textarea></div>
        <div class="col-12"><label asp-for="PrivacyText" class="form-label"></label><textarea asp-for="PrivacyText" class="form-control" rows="5"></textarea></div>
        <div class="col-12"><label asp-for="TermsText" class="form-label"></label><textarea asp-for="TermsText" class="form-control" rows="5"></textarea></div>
    </div>
    <div class="form-text mt-2">Textos exibidos como texto simples (sem HTML). Revise os textos legais com um profissional: o sistema não fornece modelos jurídicos.</div>
    <div class="mt-4"><button class="btn btn-primary">Salvar</button></div>
</div></form>
