@model CompanySettingsForm
@{ ViewData["Title"] = "Configurações - Empresa"; }
<h1 class="h3 mb-3">Configurações</h1>
<partial name="_SettingsNav" />
<form method="post" class="card stat-card"><div class="card-body">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="alert alert-light border small">Estes dados aparecem no rodapé da loja e servem de base para a futura emissão fiscal. O CNPJ é validado apenas pelos dígitos verificadores; isso <strong>não</strong> confirma a situação cadastral na Receita.</div>
    <div class="row g-3">
        <div class="col-md-6"><label asp-for="LegalName" class="form-label"></label><input asp-for="LegalName" class="form-control" /></div>
        <div class="col-md-6"><label asp-for="TradeName" class="form-label"></label><input asp-for="TradeName" class="form-control" /></div>
        <div class="col-md-4"><label asp-for="Cnpj" class="form-label"></label><input asp-for="Cnpj" class="form-control" /><span asp-validation-for="Cnpj" class="text-danger small"></span></div>
        <div class="col-md-4"><label asp-for="StateRegistration" class="form-label"></label><input asp-for="StateRegistration" class="form-control" /></div>
        <div class="col-md-4"><label asp-for="MunicipalRegistration" class="form-label"></label><input asp-for="MunicipalRegistration" class="form-control" /></div>
        <div class="col-md-6"><label asp-for="Email" class="form-label"></label><input asp-for="Email" type="email" class="form-control" /><span asp-validation-for="Email" class="text-danger small"></span></div>
        <div class="col-md-6"><label asp-for="Phone" class="form-label"></label><input asp-for="Phone" class="form-control" /></div>
        <div class="col-md-3"><label asp-for="PostalCode" class="form-label"></label><input asp-for="PostalCode" class="form-control" data-mask="cep" /><span asp-validation-for="PostalCode" class="text-danger small"></span></div>
        <div class="col-md-6"><label asp-for="Street" class="form-label"></label><input asp-for="Street" class="form-control" /></div>
        <div class="col-md-3"><label asp-for="Number" class="form-label"></label><input asp-for="Number" class="form-control" /></div>
        <div class="col-md-4"><label asp-for="Complement" class="form-label"></label><input asp-for="Complement" class="form-control" /></div>
        <div class="col-md-4"><label asp-for="District" class="form-label"></label><input asp-for="District" class="form-control" /></div>
        <div class="col-md-4"><label asp-for="City" class="form-label"></label><input asp-for="City" class="form-control" /></div>
        <div class="col-md-2"><label asp-for="State" class="form-label"></label><input asp-for="State" class="form-control text-uppercase" maxlength="2" /><span asp-validation-for="State" class="text-danger small"></span></div>
        <div class="col-md-4"><label asp-for="Country" class="form-label"></label><input asp-for="Country" class="form-control" /></div>
        <div class="col-md-6"><label asp-for="Website" class="form-label"></label><input asp-for="Website" class="form-control" /><span asp-validation-for="Website" class="text-danger small"></span></div>
        <div class="col-12"><label asp-for="SupportInfo" class="form-label"></label><textarea asp-for="SupportInfo" class="form-control" rows="3"></textarea></div>
    </div>
    <div class="mt-4"><button class="btn btn-primary">Salvar</button></div>
</div></form>
