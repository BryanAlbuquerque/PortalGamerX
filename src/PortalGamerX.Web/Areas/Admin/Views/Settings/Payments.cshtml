@model PaymentSettingsForm
@{ ViewData["Title"] = "Configurações - Pagamentos"; }
<h1 class="h3 mb-3">Configurações</h1>
<partial name="_SettingsNav" />
<div class="row g-3">
<div class="col-lg-8">
<form method="post" class="card stat-card"><div class="card-body">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <h2 class="h5">Mercado Pago (Checkout Pro)</h2>
    <div class="row g-3">
        <div class="col-12"><div class="form-check form-switch"><input asp-for="Enabled" class="form-check-input" /><label asp-for="Enabled" class="form-check-label"></label></div></div>
        <input type="hidden" asp-for="Provider" />
        <div class="col-md-4"><label asp-for="Environment" class="form-label"></label>
            <select asp-for="Environment" class="form-select"><option value="sandbox">Teste (sandbox)</option><option value="production">Produção</option></select></div>
        <div class="col-md-8"><label asp-for="PublicKey" class="form-label"></label><input asp-for="PublicKey" class="form-control" autocomplete="off" /></div>
        <div class="col-12"><label asp-for="AccessToken" class="form-label"></label>
            <input asp-for="AccessToken" type="password" class="form-control" autocomplete="new-password" placeholder="@(Model.HasAccessToken ? "•••••••• (já configurado)" : "")" value="" />
            <div class="form-text">@(Model.HasAccessToken ? "Há um token salvo. " : "Nenhum token salvo. ")O valor é gravado cifrado e nunca é exibido novamente.</div></div>
        <div class="col-12"><label asp-for="WebhookSecret" class="form-label"></label>
            <input asp-for="WebhookSecret" type="password" class="form-control" autocomplete="new-password" placeholder="@(Model.HasWebhookSecret ? "•••••••• (já configurado)" : "")" value="" />
            <div class="form-text">Sem a chave secreta, notificações de pagamento são rejeitadas (o pedido só é marcado como pago por confirmação autenticada).</div></div>
    </div>
    <div class="mt-4"><button class="btn btn-primary">Salvar</button></div>
</div></form>
</div>
<div class="col-lg-4">
    <div class="card stat-card mb-3"><div class="card-body">
        <h2 class="h6">URL do webhook</h2>
        <code class="user-select-all d-block text-break">@Model.WebhookUrl</code>
        <div class="form-text">Cadastre esta URL no painel do Mercado Pago (Suas integrações &rsaquo; Webhooks), evento "Pagamentos", e copie a chave secreta gerada para o campo ao lado. O endereço precisa ser HTTPS e público.</div>
    </div></div>
    <div class="card stat-card"><div class="card-body">
        <h2 class="h6">Testar credenciais</h2>
        <form asp-action="TestPayments" method="post"><button class="btn btn-outline-primary btn-sm">Testar conexão</button></form>
        <div class="form-text">Consulta a API do provedor com o token salvo. Não cria cobranças.</div>
    </div></div>
</div>
</div>
