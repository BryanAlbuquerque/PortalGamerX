@model StockListVm
@{
    ViewData["Title"] = "Estoque de keys";
    var baseUrl = "/Admin/Stock?" + (string.IsNullOrEmpty(Model.Q) ? "" : "q=" + Uri.EscapeDataString(Model.Q) + "&") + (Model.LowOnly ? "lowOnly=true&" : "");
    var pager = PagerVm.Create(Model.Page, Model.TotalPages, baseUrl);
}
<h1 class="h3 mb-3">Estoque de keys</h1>
<form method="get" class="row g-2 mb-3 align-items-center">
    <div class="col-md-5"><input name="q" value="@Model.Q" class="form-control" placeholder="Nome ou SKU" maxlength="100" /></div>
    <div class="col-auto"><div class="form-check"><input class="form-check-input" type="checkbox" name="lowOnly" value="true" id="lowOnly" checked="@Model.LowOnly" /><label class="form-check-label" for="lowOnly">Somente estoque baixo (≤ @Model.Threshold keys)</label></div></div>
    <div class="col-auto"><button class="btn btn-outline-secondary">Filtrar</button></div>
</form>
<div class="table-responsive bg-white rounded shadow-sm">
    <table class="table align-middle mb-0">
        <thead><tr><th>Jogo</th><th>SKU</th><th class="text-end">Keys disponíveis</th><th></th></tr></thead>
        <tbody>
        @foreach (var p in Model.Items)
        {
            <tr>
                <td>@p.Name</td>
                <td class="small">@p.Sku</td>
                <td class="text-end"><span class="badge text-bg-@(p.StockQuantity <= 0 ? "danger" : p.StockQuantity <= Model.Threshold ? "warning" : "light text-dark")">@p.StockQuantity</span></td>
                <td class="text-end text-nowrap">
                    <a class="btn btn-sm btn-outline-primary" asp-action="Import" asp-route-id="@p.Id">Importar keys</a>
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Keys" asp-route-id="@p.Id">Keys</a>
                    <a class="btn btn-sm btn-outline-secondary" asp-action="History" asp-route-id="@p.Id">Histórico</a>
                </td>
            </tr>
        }
        @if (Model.Items.Count == 0) { <tr><td colspan="4" class="text-center text-muted py-4">Nenhum jogo.</td></tr> }
        </tbody>
    </table>
</div>
<div class="mt-3"><partial name="_Pager" model="pager" /></div>
