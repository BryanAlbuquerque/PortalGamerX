@model KeyListVm
@{
    ViewData["Title"] = "Keys: " + Model.Jogo.Name;
    var st = await Store.GetAsync();
    var baseUrl = "/Admin/Stock/Keys/" + Model.Jogo.Id + "?" + (Model.Status.HasValue ? "status=" + Model.Status.Value + "&" : "");
    var pager = PagerVm.Create(Model.Page, Model.TotalPages, baseUrl);
    int Count(GameKeyStatus s) => Model.Counts.TryGetValue(s, out var n) ? n : 0;
}
<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h1 class="h3 mb-0">Keys: @Model.Jogo.Name</h1>
    <div class="d-flex gap-2">
        <a asp-action="Import" asp-route-id="@Model.Jogo.Id" class="btn btn-primary">Importar keys</a>
        <a asp-action="History" asp-route-id="@Model.Jogo.Id" class="btn btn-outline-secondary">Histórico</a>
        <a asp-action="Index" class="btn btn-outline-secondary">Voltar</a>
    </div>
</div>
<div class="mb-3 d-flex flex-wrap gap-2 align-items-center">
    <a class="btn btn-sm @(Model.Status == null ? "btn-dark" : "btn-outline-dark")" asp-action="Keys" asp-route-id="@Model.Jogo.Id">Todas</a>
    @foreach (var s in Enum.GetValues<GameKeyStatus>())
    {
        <a class="btn btn-sm @(Model.Status == s ? "btn-dark" : "btn-outline-dark")" asp-action="Keys" asp-route-id="@Model.Jogo.Id" asp-route-status="@s">@s.Label() (@Count(s))</a>
    }
    <form asp-action="Recalculate" asp-route-id="@Model.Jogo.Id" method="post" class="ms-auto" data-confirm="Recalcular o saldo a partir das keys disponíveis?">
        <button class="btn btn-sm btn-outline-secondary" title="Use se o saldo do jogo divergir da quantidade de keys disponíveis">Recalcular saldo (@Model.Jogo.StockQuantity)</button>
    </form>
</div>
<div class="table-responsive bg-white rounded shadow-sm">
    <table class="table table-sm align-middle mb-0">
        <thead><tr><th>#</th><th>Key</th><th>Situação</th><th>Pedido</th><th>Cadastro</th><th>Observação</th><th></th></tr></thead>
        <tbody>
        @foreach (var k in Model.Items)
        {
            <tr>
                <td class="small">@k.Id</td>
                <td class="font-monospace">@KeyRules.Mask(k.CodeHint)</td>
                <td><span class="badge text-bg-@(k.Status switch { GameKeyStatus.Available => "success", GameKeyStatus.Reserved => "warning", GameKeyStatus.Sold => "secondary", _ => "danger" })">@k.Status.Label()</span></td>
                <td class="small">@if (k.OrderId.HasValue) { <a asp-controller="Orders" asp-action="Details" asp-route-id="@k.OrderId">ver pedido</a> }</td>
                <td class="small">@Store.Fmt(k.CreatedAtUtc, st)<br />@k.CreatedByName</td>
                <td class="small">@k.Note</td>
                <td class="text-end text-nowrap">
                    <form asp-action="Reveal" method="post" class="d-inline" data-confirm="Revelar esta key? A ação fica registrada na auditoria.">
                        <input type="hidden" name="keyId" value="@k.Id" /><button class="btn btn-sm btn-outline-secondary">Revelar</button>
                    </form>
                    @if (k.Status is GameKeyStatus.Available or GameKeyStatus.Sold)
                    {
                        <form asp-action="VoidKey" method="post" class="d-inline-flex gap-1">
                            <input type="hidden" name="keyId" value="@k.Id" /><input type="hidden" name="jogoId" value="@Model.Jogo.Id" />
                            <input name="reason" class="form-control form-control-sm" style="width:150px" placeholder="Motivo (obrigatório)" maxlength="300" required />
                            <button class="btn btn-sm btn-outline-danger">Invalidar</button>
                        </form>
                    }
                </td>
            </tr>
        }
        @if (Model.Items.Count == 0) { <tr><td colspan="7" class="text-center text-muted py-4">Nenhuma key.</td></tr> }
        </tbody>
    </table>
</div>
<div class="mt-3"><partial name="_Pager" model="pager" /></div>
