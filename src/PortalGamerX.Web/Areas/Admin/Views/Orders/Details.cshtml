@model AdminOrderVm
@{
    var o = Model.Order;
    ViewData["Title"] = "Pedido " + o.Number;
    var st = await Store.GetAsync();
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Pedido @o.Number</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">Voltar</a>
</div>
@if (o.Status == OrderStatus.Paid)
{
    <div class="alert alert-warning d-flex justify-content-between align-items-center">
        <span>Pedido pago, mas as keys ainda <strong>não foram entregues</strong> (veja o histórico). Corrija o estoque de keys, se preciso, e tente novamente.</span>
        <form asp-action="DeliverKeys" asp-route-id="@o.Id" method="post"><button class="btn btn-sm btn-warning">Entregar keys</button></form>
    </div>
}
@if (o.Status == OrderStatus.Cancelled && o.PaymentStatus == PaymentStatus.Approved)
{
    <div class="alert alert-warning">Pedido cancelado com pagamento aprovado: revise manualmente (reembolso/estorno).</div>
}
<div class="row g-3">
    <div class="col-lg-8">
        <div class="card stat-card mb-3"><div class="card-body">
            <div class="d-flex flex-wrap gap-2 align-items-center mb-3">
                <span class="badge text-bg-@o.Status.Badge() fs-6">@o.Status.Label()</span>
                <span class="badge text-bg-@o.PaymentStatus.Badge()">Pagamento: @o.PaymentStatus.Label()</span>
                <span class="text-muted small">Criado em @Store.Fmt(o.CreatedAtUtc, st)</span>
                @if (o.PaidAtUtc.HasValue) { <span class="text-muted small">Pago em @Store.Fmt(o.PaidAtUtc, st)</span> }
            </div>
            <div class="table-responsive"><table class="table table-sm align-middle">
                <thead><tr><th>Jogo</th><th>SKU</th><th class="text-end">Preço</th><th class="text-end">Qtd.</th><th class="text-end">Subtotal</th></tr></thead>
                <tbody>
                @foreach (var i in o.Items)
                {
                    <tr><td>@i.JogoName</td><td class="small">@i.Sku</td><td class="text-end">@i.UnitPrice.ToBrl()</td><td class="text-end">@i.Quantity</td><td class="text-end">@i.LineTotal.ToBrl()</td></tr>
                }
                </tbody>
                <tfoot>
                    <tr><td colspan="4" class="text-end">Subtotal</td><td class="text-end">@o.Subtotal.ToBrl()</td></tr>
                    @if (o.DiscountTotal > 0) { <tr><td colspan="4" class="text-end">Desconto @(string.IsNullOrEmpty(o.CouponCode) ? "" : "(" + o.CouponCode + ")")</td><td class="text-end">- @o.DiscountTotal.ToBrl()</td></tr> }
                    <tr class="fw-bold"><td colspan="4" class="text-end">Total</td><td class="text-end">@o.Total.ToBrl()</td></tr>
                </tfoot>
            </table></div>
        </div></div>

        @if (o.Status is OrderStatus.Delivered or OrderStatus.Paid || Model.Keys.Count > 0)
        {
        <div class="card stat-card mb-3"><div class="card-body">
            <h2 class="h6">Keys entregues</h2>
            @if (Model.Keys.Count == 0) { <p class="text-muted small mb-0">Nenhuma key vendida neste pedido.</p> }
            else
            {
                <div class="table-responsive"><table class="table table-sm align-middle mb-0">
                    <thead><tr><th>Jogo</th><th>Ativação</th><th>Key</th></tr></thead>
                    <tbody>
                    @foreach (var k in Model.Keys)
                    {
                        <tr>
                            <td>@k.JogoName</td>
                            <td class="small">@k.Store.Label() · @k.Region.Label()</td>
                            <td>
                                <form asp-controller="Stock" asp-action="Reveal" method="post" data-confirm="Revelar esta key? A ação fica registrada na auditoria.">
                                    <input type="hidden" name="keyId" value="@k.KeyId" /><button class="btn btn-sm btn-outline-secondary">Revelar key #@k.KeyId</button>
                                </form>
                            </td>
                        </tr>
                    }
                    </tbody></table></div>
            }
        </div></div>
        }

        <div class="card stat-card mb-3"><div class="card-body">
            <h2 class="h6">Pagamentos</h2>
            @if (o.Payments.Count == 0) { <p class="text-muted mb-0">Nenhum pagamento iniciado.</p> }
            else
            {
                <div class="table-responsive"><table class="table table-sm align-middle mb-2">
                    <thead><tr><th>Provedor</th><th>Status</th><th>Detalhe</th><th>Método</th><th class="text-end">Valor</th><th>ID externo</th></tr></thead>
                    <tbody>
                    @foreach (var p in o.Payments.OrderByDescending(p => p.CreatedAtUtc))
                    {
                        <tr><td>@p.Provider</td><td><span class="badge text-bg-@p.Status.Badge()">@p.Status.Label()</span></td><td class="small">@p.StatusDetail</td><td class="small">@p.PaymentMethod</td><td class="text-end">@p.Amount.ToBrl()</td><td class="small">@p.ExternalPaymentId</td></tr>
                    }
                    </tbody></table></div>
            }
            @if (Model.CanRefund)
            {
                <form asp-action="Refund" asp-route-id="@o.Id" method="post" data-confirm="Solicitar o reembolso integral deste pagamento ao provedor?">
                    <button class="btn btn-sm btn-outline-danger">Reembolsar pagamento</button>
                </form>
            }
        </div></div>

        <div class="card stat-card mb-3"><div class="card-body">
            <h2 class="h6">Documento fiscal</h2>
            @if (!Model.FiscalConfigured)
            {
                <div class="alert alert-secondary small">A integração fiscal <strong>não está configurada</strong>: nenhuma NFS-e é emitida por este sistema. Veja Configurações &rsaquo; Fiscal.</div>
            }
            @foreach (var d in Model.FiscalDocuments)
            {
                <div class="border rounded p-2 mb-2 small">
                    <strong>@d.DocumentType</strong> — @d.Status.Label() @if (!string.IsNullOrEmpty(d.Number)) { <text>nº @d.Number</text> }
                    @if (!string.IsNullOrEmpty(d.RejectionMessage)) { <div class="text-danger">@d.RejectionMessage</div> }
                    @if (!string.IsNullOrEmpty(d.AccessKey)) { <div>Chave: @d.AccessKey</div> }
                    <form asp-action="RefreshFiscal" asp-route-id="@o.Id" asp-route-documentId="@d.Id" method="post" class="mt-1"><button class="btn btn-sm btn-outline-secondary">Atualizar situação</button></form>
                </div>
            }
            <form asp-action="RequestFiscal" asp-route-id="@o.Id" method="post">
                <button class="btn btn-sm btn-outline-primary" disabled="@(!Model.FiscalConfigured)">Solicitar emissão</button>
            </form>
        </div></div>

        <div class="card stat-card"><div class="card-body">
            <h2 class="h6">Histórico</h2>
            <ul class="list-unstyled small mb-0">
            @foreach (var h in o.History.OrderByDescending(h => h.CreatedAtUtc))
            {
                <li class="mb-1"><span class="text-muted">@Store.Fmt(h.CreatedAtUtc, st)</span> — @(h.FromStatus.HasValue ? h.FromStatus.Value.Label() + " → " : "")<strong>@h.ToStatus.Label()</strong>
                    @if (!string.IsNullOrEmpty(h.ChangedByName)) { <text> por @h.ChangedByName</text> }
                    @if (!string.IsNullOrEmpty(h.Note)) { <div class="text-muted">@h.Note</div> }</li>
            }
            </ul>
        </div></div>
    </div>

    <div class="col-lg-4">
        <div class="card stat-card mb-3"><div class="card-body">
            <h2 class="h6">Alterar status</h2>
            @if (Model.AllowedTargets.Count == 0) { <p class="text-muted small mb-0">Este pedido está em estado final ou não aceita alteração manual.</p> }
            else
            {
                <form asp-action="ChangeStatus" method="post">
                    <input type="hidden" name="Id" value="@o.Id" />
                    <div class="mb-2"><label class="form-label small" for="Target">Novo status</label>
                        <select name="Target" id="Target" class="form-select">
                            @foreach (var t in Model.AllowedTargets) { <option value="@t">@t.Label()</option> }
                        </select></div>
                    <div class="mb-2"><label class="form-label small" for="Note">Observação</label><input name="Note" id="Note" class="form-control" maxlength="500" /></div>
                    <button class="btn btn-primary btn-sm">Atualizar</button>
                    <div class="form-text">"Pago" e "Entregue" são automáticos após a confirmação do pagamento. Cancelar devolve as keys reservadas ao estoque.</div>
                </form>
            }
        </div></div>

        <div class="card stat-card mb-3"><div class="card-body">
            <h2 class="h6">Cliente</h2>
            <div>@o.CustomerName</div>
            <div class="small">@o.CustomerEmail</div>
            @if (!string.IsNullOrEmpty(o.CustomerPhone)) { <div class="small">@o.CustomerPhone</div> }
            @if (!string.IsNullOrEmpty(o.CustomerDocument)) { <div class="small">Documento: @o.CustomerDocument</div> }
            <a class="small" asp-controller="Customers" asp-action="Details" asp-route-id="@o.UserId">Ver cliente</a>
            <hr />
            <h2 class="h6">Cobrança (nota fiscal)</h2>
            <div class="small">@o.BillingStreet, @o.BillingNumber @o.BillingComplement<br />@o.BillingDistrict - @o.BillingCity/@o.BillingState<br />CEP @Documents.FormatPostalCode(o.BillingPostalCode)</div>
            <div class="small text-muted mt-1">Produto digital: sem envio.</div>
            @if (!string.IsNullOrEmpty(o.CustomerNotes)) { <hr /><h2 class="h6">Observação do cliente</h2><div class="small text-pre">@o.CustomerNotes</div> }
        </div></div>

        <div class="card stat-card"><div class="card-body">
            <h2 class="h6">Observações internas</h2>
            <form asp-action="SaveNotes" asp-route-id="@o.Id" method="post">
                <textarea name="notes" class="form-control mb-2" rows="4" maxlength="2000">@o.AdminNotes</textarea>
                <button class="btn btn-sm btn-outline-primary">Salvar</button>
            </form>
        </div></div>
    </div>
</div>
