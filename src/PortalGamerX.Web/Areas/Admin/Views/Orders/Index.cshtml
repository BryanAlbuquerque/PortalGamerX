@model AdminOrderListVm
@{
    ViewData["Title"] = "Pedidos";
    var st = await Store.GetAsync();
    var baseUrl = "/Admin/Orders?" + (string.IsNullOrEmpty(Model.Q) ? "" : "q=" + Uri.EscapeDataString(Model.Q) + "&") + (Model.Status.HasValue ? "status=" + Model.Status.Value + "&" : "");
    var pager = PagerVm.Create(Model.Page, Model.TotalPages, baseUrl);
}
<h1 class="h3 mb-3">Pedidos <small class="text-muted fs-6">(@Model.Total)</small></h1>
<form method="get" class="row g-2 mb-3">
    <div class="col-md-5"><input name="q" value="@Model.Q" class="form-control" placeholder="Número, nome ou e-mail" maxlength="100" /></div>
    <div class="col-md-3">
        <select name="status" class="form-select">
            <option value="">Todos os status</option>
            @foreach (var s in Enum.GetValues<OrderStatus>())
            {
                <option value="@s" selected="@(Model.Status == s)">@s.Label()</option>
            }
        </select>
    </div>
    <div class="col-auto"><button class="btn btn-outline-secondary">Filtrar</button></div>
</form>
<div class="table-responsive bg-white rounded shadow-sm">
    <table class="table align-middle mb-0">
        <thead><tr><th>Pedido</th><th>Data</th><th>Cliente</th><th>Status</th><th>Pagamento</th><th class="text-end">Total</th><th></th></tr></thead>
        <tbody>
        @foreach (var o in Model.Items)
        {
            <tr>
                <td><a asp-action="Details" asp-route-id="@o.Id">@o.Number</a> @if (o.CancellationRequested) { <span class="badge text-bg-danger">Cancel. solicitado</span> }</td>
                <td class="small">@Store.Fmt(o.CreatedAtUtc, st)</td>
                <td>@o.CustomerName<div class="small text-muted">@o.CustomerEmail</div></td>
                <td><span class="badge text-bg-@o.Status.Badge()">@o.Status.Label()</span></td>
                <td><span class="badge text-bg-@o.PaymentStatus.Badge()">@o.PaymentStatus.Label()</span></td>
                <td class="text-end">@o.Total.ToBrl()</td>
                <td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@o.Id">Abrir</a></td>
            </tr>
        }
        @if (Model.Items.Count == 0) { <tr><td colspan="7" class="text-center text-muted py-4">Nenhum pedido encontrado.</td></tr> }
        </tbody>
    </table>
</div>
<div class="mt-3"><partial name="_Pager" model="pager" /></div>
