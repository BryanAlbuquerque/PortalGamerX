@model CheckoutVm
@{
    ViewData["Title"] = "Finalizar compra";
    var baseTotal = (Model.Cart.Subtotal - Model.Cart.Discount).ToString("0.00", System.Globalization.CultureInfo.InvariantCulture);
}
<h1 class="h3 mb-3">Finalizar compra</h1>
@if (!Model.PaymentEnabled)
{
    <div class="alert alert-warning">O pagamento online não está disponível no momento. Entre em contato com a loja.</div>
}
<form asp-antiforgery="true" method="post" action="/checkout" data-checkout data-shipping-url="/checkout/frete" data-base-total="@baseTotal" data-payment-enabled="@(Model.PaymentEnabled ? "true" : "false")">
    <input type="hidden" name="IdempotencyKey" value="@Model.IdempotencyKey" />
    <input type="hidden" name="ShippingServiceCode" value="" />
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="bg-white rounded shadow-sm p-3 mb-3">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">1. Endereço de entrega</h5>
                    <a href="/conta/enderecos/novo?returnUrl=/checkout" class="btn btn-outline-secondary btn-sm">Novo endereço</a>
                </div>
                @if (Model.Addresses.Count == 0)
                {
                    <p class="mt-3 mb-0 text-muted">Você ainda não tem endereços. <a href="/conta/enderecos/novo?returnUrl=/checkout">Cadastre um endereço</a> para continuar.</p>
                }
                else
                {
                    <div class="list-group mt-3">
                        @foreach (var a in Model.Addresses)
                        {
                            <label class="list-group-item d-flex gap-2">
                                <input class="form-check-input mt-1" type="radio" name="AddressId" value="@a.Id" checked="@(a.Id == Model.SelectedAddressId)" required />
                                <span>
                                    <strong>@a.Label</strong> - @a.RecipientName<br />
                                    <span class="small text-muted">@a.Street, @a.Number@(string.IsNullOrWhiteSpace(a.Complement) ? "" : " - " + a.Complement) · @a.District · @a.City/@a.State · CEP @Documents.FormatPostalCode(a.PostalCode)</span>
                                </span>
                            </label>
                        }
                    </div>
                }
            </div>
            <div class="bg-white rounded shadow-sm p-3 mb-3">
                <h5>2. Frete</h5>
                <div class="list-group" data-shipping-options><span class="text-muted">Selecione um endereço.</span></div>
            </div>
            <div class="bg-white rounded shadow-sm p-3 mb-3">
                <h5>3. Pagamento</h5>
                <p class="mb-1">Mercado Pago (cartão, Pix, boleto e outros meios habilitados na sua conta do Mercado Pago).</p>
                <p class="small text-muted mb-0">Você será redirecionado ao ambiente seguro do Mercado Pago. Seus dados de cartão não passam por esta loja. O pedido só é confirmado após a aprovação do pagamento.</p>
            </div>
            <div class="bg-white rounded shadow-sm p-3">
                <label class="form-label" for="Notes">Observações do pedido (opcional)</label>
                <textarea id="Notes" name="Notes" class="form-control" rows="2" maxlength="1000"></textarea>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="bg-white rounded shadow-sm p-3 summary-card">
                <h5>Resumo do pedido</h5>
                @foreach (var l in Model.Cart.Lines)
                {
                    <div class="d-flex justify-content-between small"><span>@l.Quantity× @l.Name</span><span>@l.LineTotal.ToBrl()</span></div>
                }
                <hr />
                <div class="d-flex justify-content-between"><span>Subtotal</span><span>@Model.Cart.Subtotal.ToBrl()</span></div>
                @if (Model.Cart.Discount > 0)
                {
                    <div class="d-flex justify-content-between text-success"><span>Desconto</span><span>- @Model.Cart.Discount.ToBrl()</span></div>
                }
                <div class="d-flex justify-content-between"><span>Frete</span><span data-shipping-total>a calcular</span></div>
                <div class="d-flex justify-content-between fw-bold fs-5 mt-2"><span>Total</span><span data-total>@((Model.Cart.Subtotal - Model.Cart.Discount).ToBrl())</span></div>
                <div class="small text-muted mb-3">O valor final é recalculado e confirmado pelo servidor ao enviar o pedido.</div>
                <button type="submit" class="btn btn-brand w-100 btn-lg" data-checkout-submit disabled>Pagar com Mercado Pago</button>
            </div>
        </div>
    </div>
</form>
