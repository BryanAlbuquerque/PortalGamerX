@model JogoCardVm
<div class="card product-card h-100">
    <a href="/produto/@Model.Slug" class="product-thumb">
        @if (!string.IsNullOrEmpty(Model.ImagePath))
        {
            <img src="@Model.ImagePath" class="card-img-top" alt="@Model.Name" loading="lazy" />
        }
        else
        {
            <div class="no-image">Sem imagem</div>
        }
        @if (Model.IsOnSale) { <span class="badge bg-danger sale-badge">Oferta</span> }
    </a>
    <div class="card-body d-flex flex-column">
        <h6 class="card-title"><a href="/produto/@Model.Slug" class="text-reset text-decoration-none">@Model.Name</a></h6>
        <div class="mt-auto">
            @if (Model.IsOnSale)
            {
                <div class="text-muted text-decoration-line-through small">@Model.Price.ToBrl()</div>
            }
            <div class="fs-5 fw-bold price">@Model.EffectivePrice.ToBrl()</div>
            @if (Model.IsPurchasable)
            {
                <form asp-antiforgery="true" method="post" action="/carrinho/adicionar" class="mt-2">
                    <input type="hidden" name="productId" value="@Model.Id" />
                    <input type="hidden" name="quantity" value="1" />
                    <button type="submit" class="btn btn-brand w-100 btn-sm">Adicionar ao carrinho</button>
                </form>
            }
            else
            {
                <span class="badge bg-secondary mt-2">Indisponível</span>
            }
        </div>
    </div>
</div>
