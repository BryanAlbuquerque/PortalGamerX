@model Order
@{
    ViewData["Title"] = "Pedido " + Model.Number;
    var paymentEnabled = ViewBag.PaymentEnabled is bool b && b;
}
<div class="row">
    <div class="col-md-3"><partial name="_Nav" /></div>
    <div class="col-md-9">
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
            <h1 class="h4 mb-0">Pedido @Model.Number</h1>
            <div>
                <span class="badge bg-@Model.Status.Badge() fs-6">@Model.Status.Label()</span>
                <span class="badge bg-@Model.PaymentStatus.Badge() fs-6">Pagamento: @Model.PaymentStatus.Label()</span>
            </div>
        </div>

        @if (Model.Status == OrderStatus.PendingPayment)
        {
            <div class="alert alert-warning d-flex flex-wrap justify-content-between align-items-center gap-2">
                <span>Aguardando pagamento@(Model.ExpiresAtUtc.HasValue ? $". Expira em {Model.ExpiresAtUtc.Value:dd/MM/yyyy HH:mm} UTC" : "").</span>
                <span class="d-flex gap-2">
                    @if (paymentEnabled)
                    {
                        <form asp-antiforgery="true" method="post" action="/conta/pedidos/@Model.Id/pagar"><button class="btn btn-brand btn-sm" type="submit">Pagar agora</button></form>
                    }
                    <form asp-antiforgery="true" method="post" action="/conta/pedidos/@Model.Id/cancelar" data-confirm="Cancelar este pedido?"><button class="btn btn-outline-danger btn-sm" type="submit">Cancelar pedido</button></form>
                </span>
            </div>
        }
        @if (Model.Status == OrderStatus.Paid)
        {
            <div class="alert alert-info">Pagamento aprovado! Estamos liberando as suas keys; atualize esta página em instantes.</div>
        }
        @if (Model.Status == OrderStatus.Delivered && ViewBag.Keys is List<DeliveredKey> keys)
        {
            <div class="bg-white rounded shadow-sm p-3 mb-3 border border-success">
                <h5 class="mb-1">Suas keys</h5>
                <p class="small text-muted">Guarde com segurança e não compartilhe. Cada key só pode ser ativada uma vez, na loja e região indicadas. Uma cópia também foi enviada ao seu e-mail.</p>
                @foreach (var g in keys.GroupBy(k => k.JogoId))
                {
                    var first = g.First();
                    <div class="mb-3">
                        <div class="fw-semibold">@first.JogoName</div>
                        <div class="small text-muted mb-1">Ativar em: <strong>@first.Store.Label()</strong> · Região: <strong>@first.Region.Label()</strong></div>
                        @foreach (var k in g)
                        {
                            <div class="font-monospace fs-5 user-select-all border rounded px-2 py-1 mb-1 bg-light">@k.Code</div>
                        }
                        @if (!string.IsNullOrWhiteSpace(first.Instructions)) { <div class="small text-pre mt-1">@first.Instructions</div> }
                    </div>
                }
                @if (keys.Count == 0) { <p class="text-muted mb-0">Nenhuma key encontrada. Entre em contato com o suporte informando o número do pedido.</p> }
            </div>
        }
        @if (Model.Status == OrderStatus.Cancelled && Model.PaymentStatus is PaymentStatus.Refunded or PaymentStatus.ChargedBack)
        {
            <div class="alert alert-secondary">Pedido cancelado e pagamento devolvido. As keys deste pedido foram invalidadas.</div>
        }

        <div class="row g-3">
            <div class="col-lg-7">
                <div class="bg-white rounded shadow-sm p-3 mb-3">
                    <h6>Itens</h6>
                    <table class="table table-sm mb-0">
                        <tbody>
                        @foreach (var i in Model.Items)
                        {
                            <tr><td>@i.Quantity× @i.JogoName <span class="text-muted small">(@i.Sku)</span></td><td class="text-end">@i.LineTotal.ToBrl()</td></tr>
                        }
                        </tbody>
                    </table>
                    <hr />
                    <div class="d-flex justify-content-between"><span>Subtotal</span><span>@Model.Subtotal.ToBrl()</span></div>
                    @if (Model.DiscountTotal > 0) { <div class="d-flex justify-content-between text-success"><span>Desconto @Model.CouponCode</span><span>- @Model.DiscountTotal.ToBrl()</span></div> }
                    <div class="d-flex justify-content-between fw-bold fs-5"><span>Total</span><span>@Model.Total.ToBrl()</span></div>
                </div>
                <div class="bg-white rounded shadow-sm p-3">
                    <h6>Histórico</h6>
                    <ul class="list-unstyled small mb-0">
                        @foreach (var h in Model.History)
                        {
                            <li class="mb-1">@h.CreatedAtUtc.ToString("dd/MM/yyyy HH:mm") UTC - <strong>@h.ToStatus.Label()</strong>@(string.IsNullOrWhiteSpace(h.Note) ? "" : " - " + h.Note)</li>
                        }
                    </ul>
                </div>
            </div>
            <div class="col-lg-5">
                <div class="bg-white rounded shadow-sm p-3 mb-3">
                    <h6>Entrega digital</h6>
                    <div class="small text-muted">Sem frete e sem envio: as keys são liberadas aqui e por e-mail assim que o pagamento é aprovado.</div>
                    <hr />
                    <h6>Dados de cobrança</h6>
                    <div class="small">
                        @Model.CustomerName<br />
                        @Model.BillingStreet, @Model.BillingNumber@(string.IsNullOrWhiteSpace(Model.BillingComplement) ? "" : " - " + Model.BillingComplement)<br />
                        @Model.BillingDistrict · @Model.BillingCity/@Model.BillingState<br />
                        CEP @Documents.FormatPostalCode(Model.BillingPostalCode)
                    </div>
                </div>
                <div class="bg-white rounded shadow-sm p-3 mb-3">
                    <h6>Pagamentos</h6>
                    @if (Model.Payments.Count == 0) { <p class="small text-muted mb-0">Nenhuma tentativa de pagamento registrada.</p> }
                    @foreach (var p in Model.Payments.OrderByDescending(x => x.CreatedAtUtc))
                    {
                        <div class="small border-bottom py-1">
                            @p.Provider · <span class="badge bg-@p.Status.Badge()">@p.Status.Label()</span> · @p.Amount.ToBrl()
                            @if (!string.IsNullOrWhiteSpace(p.PaymentMethod)) { <span> · @p.PaymentMethod</span> }
                            <div class="text-muted">@p.CreatedAtUtc.ToString("dd/MM/yyyy HH:mm") UTC</div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
