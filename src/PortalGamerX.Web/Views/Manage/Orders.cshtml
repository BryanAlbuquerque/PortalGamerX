@model OrderListVm
@{
    ViewData["Title"] = "Meus pedidos";
    var pager = PagerVm.Create(Model.Page, Model.TotalPages, "/conta/pedidos?");
}
<div class="row">
    <div class="col-md-3"><partial name="_Nav" /></div>
    <div class="col-md-9">
        <h1 class="h4 mb-3">Meus pedidos</h1>
        @if (Model.Orders.Count == 0)
        {
            <div class="alert alert-light border">Você ainda não fez pedidos. <a href="/jogos">Ver jogos</a></div>
        }
        else
        {
            <div class="table-responsive bg-white rounded shadow-sm">
                <table class="table align-middle mb-0">
                    <thead><tr><th>Pedido</th><th>Data</th><th>Status</th><th>Pagamento</th><th class="text-end">Total</th><th></th></tr></thead>
                    <tbody>
                    @foreach (var o in Model.Orders)
                    {
                        <tr>
                            <td>@o.Number</td>
                            <td>@o.CreatedAtUtc.ToString("dd/MM/yyyy HH:mm") UTC</td>
                            <td><span class="badge bg-@o.Status.Badge()">@o.Status.Label()</span></td>
                            <td><span class="badge bg-@o.PaymentStatus.Badge()">@o.PaymentStatus.Label()</span></td>
                            <td class="text-end">@o.Total.ToBrl()</td>
                            <td class="text-end"><a class="btn btn-outline-secondary btn-sm" href="/conta/pedidos/@o.Id">Detalhes</a></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            <div class="mt-3"><partial name="_Pager" model="pager" /></div>
        }
    </div>
</div>
