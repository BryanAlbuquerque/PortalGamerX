@model List<Banner>
@{ ViewData["Title"] = "Banners"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Banners</h1>
    <a class="btn btn-primary" asp-action="Create">Novo banner</a>
</div>
<div class="table-responsive bg-white rounded shadow-sm">
    <table class="table align-middle mb-0">
        <thead><tr><th></th><th>Título</th><th>Link</th><th>Ordem</th><th>Status</th><th></th></tr></thead>
        <tbody>
        @foreach (var b in Model)
        {
            <tr>
                <td style="width:120px"><img src="@b.ImagePath" alt="" class="rounded" style="width:110px;height:50px;object-fit:cover" /></td>
                <td><a asp-action="Edit" asp-route-id="@b.Id">@b.Title</a><div class="small text-muted">@b.Subtitle</div></td>
                <td class="small">@b.LinkUrl</td>
                <td>@b.SortOrder</td>
                <td>@if (b.IsActive) { <span class="badge text-bg-success">Ativo</span> } else { <span class="badge text-bg-secondary">Inativo</span> }</td>
                <td class="text-end text-nowrap">
                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@b.Id">Editar</a>
                    <form asp-action="Toggle" asp-route-id="@b.Id" method="post" class="d-inline"><button class="btn btn-sm btn-outline-secondary">@(b.IsActive ? "Desativar" : "Ativar")</button></form>
                    <form asp-action="Delete" asp-route-id="@b.Id" method="post" class="d-inline" data-confirm="Excluir este banner?"><button class="btn btn-sm btn-outline-danger">Excluir</button></form>
                </td>
            </tr>
        }
        @if (Model.Count == 0) { <tr><td colspan="6" class="text-center text-muted py-4">Nenhum banner cadastrado.</td></tr> }
        </tbody>
    </table>
</div>
