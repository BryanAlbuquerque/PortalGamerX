@model CustomerListVm
@{
    ViewData["Title"] = "Clientes";
    var st = await Store.GetAsync();
    var pager = PagerVm.Create(Model.Page, Model.TotalPages, "/Admin/Customers?" + (string.IsNullOrEmpty(Model.Q) ? "" : "q=" + Uri.EscapeDataString(Model.Q) + "&"));
}
<h1 class="h3 mb-3">Clientes</h1>
<form method="get" class="row g-2 mb-3">
    <div class="col-md-6"><input name="q" value="@Model.Q" class="form-control" placeholder="Nome ou e-mail" maxlength="100" /></div>
    <div class="col-auto"><button class="btn btn-outline-secondary">Buscar</button></div>
</form>
<div class="table-responsive bg-white rounded shadow-sm">
    <table class="table align-middle mb-0">
        <thead><tr><th>Nome</th><th>E-mail</th><th>Cadastro</th><th>Status</th><th></th></tr></thead>
        <tbody>
        @foreach (var u in Model.Items)
        {
            <tr>
                <td><a asp-action="Details" asp-route-id="@u.Id">@u.FullName</a></td>
                <td class="small">@u.Email @if (!u.EmailConfirmed) { <span class="badge text-bg-warning">não confirmado</span> }</td>
                <td class="small">@Store.Fmt(u.CreatedAtUtc, st, false)</td>
                <td>@if (u.IsActive) { <span class="badge text-bg-success">Ativo</span> } else { <span class="badge text-bg-secondary">Bloqueado</span> }</td>
                <td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@u.Id">Detalhes</a></td>
            </tr>
        }
        @if (Model.Items.Count == 0) { <tr><td colspan="5" class="text-center text-muted py-4">Nenhum cliente encontrado.</td></tr> }
        </tbody>
    </table>
</div>
<div class="mt-3"><partial name="_Pager" model="pager" /></div>
