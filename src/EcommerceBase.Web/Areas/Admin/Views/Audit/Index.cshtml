@model AuditListVm
@{
    ViewData["Title"] = "Auditoria";
    var st = await Store.GetAsync();
    var pager = PagerVm.Create(Model.Page, Model.TotalPages, "/Admin/Audit?");
}
<h1 class="h3 mb-3">Auditoria</h1>
<p class="text-muted small">Registro de ações administrativas. Segredos e senhas nunca são gravados aqui.</p>
<div class="table-responsive bg-white rounded shadow-sm">
    <table class="table table-sm align-middle mb-0">
        <thead><tr><th>Data</th><th>Usuário</th><th>Ação</th><th>Entidade</th><th>Detalhes</th><th>IP</th></tr></thead>
        <tbody>
        @foreach (var a in Model.Items)
        {
            <tr><td class="small text-nowrap">@Store.Fmt(a.CreatedAtUtc, st)</td><td class="small">@a.UserName</td><td class="small">@a.Action</td><td class="small">@a.EntityType @a.EntityId</td><td class="small">@a.Details</td><td class="small">@a.IpAddress</td></tr>
        }
        @if (Model.Items.Count == 0) { <tr><td colspan="6" class="text-center text-muted py-4">Sem registros.</td></tr> }
        </tbody>
    </table>
</div>
<div class="mt-3"><partial name="_Pager" model="pager" /></div>
