@model List<Brand>
@{ ViewData["Title"] = "Marcas"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Marcas</h1>
    <a class="btn btn-primary" asp-action="Create">Nova marca</a>
</div>
<div class="table-responsive bg-white rounded shadow-sm">
    <table class="table align-middle mb-0">
        <thead><tr><th>Nome</th><th>Status</th><th></th></tr></thead>
        <tbody>
        @foreach (var b in Model)
        {
            <tr>
                <td><a asp-action="Edit" asp-route-id="@b.Id">@b.Name</a></td>
                <td>@if (b.IsActive) { <span class="badge text-bg-success">Ativa</span> } else { <span class="badge text-bg-secondary">Inativa</span> }</td>
                <td class="text-end text-nowrap">
                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@b.Id">Editar</a>
                    <form asp-action="Delete" asp-route-id="@b.Id" method="post" class="d-inline" data-confirm="Excluir a marca '@b.Name'?"><button class="btn btn-sm btn-outline-danger">Excluir</button></form>
                </td>
            </tr>
        }
        @if (Model.Count == 0) { <tr><td colspan="3" class="text-center text-muted py-4">Nenhuma marca cadastrada.</td></tr> }
        </tbody>
    </table>
</div>
