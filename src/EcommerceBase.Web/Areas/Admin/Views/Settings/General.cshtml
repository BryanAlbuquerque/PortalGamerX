@model GeneralSettingsForm
@{ ViewData["Title"] = "Configurações - Gerais"; }
<h1 class="h3 mb-3">Configurações</h1>
<partial name="_SettingsNav" />
<form method="post" class="card stat-card" style="max-width:720px"><div class="card-body">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="row g-3">
        <div class="col-12"><label asp-for="StoreName" class="form-label"></label><input asp-for="StoreName" class="form-control" /><span asp-validation-for="StoreName" class="text-danger small"></span></div>
        <div class="col-md-4"><label asp-for="Currency" class="form-label"></label><input asp-for="Currency" class="form-control" readonly /><span asp-validation-for="Currency" class="text-danger small"></span></div>
        <div class="col-md-8"><label asp-for="TimeZoneId" class="form-label"></label><input asp-for="TimeZoneId" class="form-control" /><span asp-validation-for="TimeZoneId" class="text-danger small"></span>
            <div class="form-text">Ex.: America/Sao_Paulo (Linux/Render) ou E. South America Standard Time (Windows).</div></div>
        <div class="col-md-4"><label asp-for="LowStockThreshold" class="form-label"></label><input asp-for="LowStockThreshold" type="number" min="0" class="form-control" /><span asp-validation-for="LowStockThreshold" class="text-danger small"></span></div>
        <div class="col-md-4"><label asp-for="PendingOrderExpirationMinutes" class="form-label"></label><input asp-for="PendingOrderExpirationMinutes" type="number" min="15" class="form-control" /><span asp-validation-for="PendingOrderExpirationMinutes" class="text-danger small"></span></div>
        <div class="col-md-4"><label asp-for="MaxItemQuantityPerProduct" class="form-label"></label><input asp-for="MaxItemQuantityPerProduct" type="number" min="1" max="99" class="form-control" /><span asp-validation-for="MaxItemQuantityPerProduct" class="text-danger small"></span></div>
    </div>
    <div class="mt-4"><button class="btn btn-primary">Salvar</button></div>
</div></form>
