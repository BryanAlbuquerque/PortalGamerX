@model AdminProductListVm
@{
    ViewData["Title"] = "Produtos";
    var baseUrl = "/Admin/Products?" + (string.IsNullOrEmpty(Model.Q) ? "" : "q=" + Uri.EscapeDataString(Model.Q) + "&") + (string.IsNullOrEmpty(Model.Filter) ? "" : "filter=" + Uri.EscapeDataString(Model.Filter) + "&");
    var pager = PagerVm.Create(Model.Page, Model.TotalPages, baseUrl);
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Produtos <small class="text-muted fs-6">(@Model.Total)</small></h1>
    <a class="btn btn-primary" asp-action="Create">Novo produto</a>
</div>
<form method="get" class="row g-2 mb-3">
    <div class="col-md-5"><input name="q" value="@Model.Q" class="form-control" placeholder="Nome ou SKU" maxlength="100" /></div>
    <div class="col-md-3">
        <select name="filter" class="form-select">
            <option value="">Todos</option>
            <option value="active" selected="@(Model.Filter == "active")">Ativos</option>
            <option value="inactive" selected="@(Model.Filter == "inactive")">Inativos</option>
            <option value="featured" selected="@(Model.Filter == "featured")">Em destaque</option>
            <option value="nostock" selected="@(Model.Filter == "nostock")">Sem estoque</option>
        </select>
    </div>
    <div class="col-auto"><button class="btn btn-outline-secondary">Filtrar</button></div>
</form>
<div class="table-responsive bg-white rounded shadow-sm">
    <table class="table align-middle mb-0">
        <thead><tr><th></th><th>Produto</th><th>SKU</th><th>Categoria</th><th class="text-end">Preço</th><th class="text-end">Estoque</th><th>Status</th><th></th></tr></thead>
        <tbody>
        @foreach (var p in Model.Items)
        {
            var img = p.Images.OrderByDescending(i => i.IsPrimary).ThenBy(i => i.SortOrder).FirstOrDefault();
            <tr>
                <td style="width:56px">@if (img != null) { <img src="@img.Path" alt="" class="rounded" style="width:44px;height:44px;object-fit:cover" /> }</td>
                <td><a asp-action="Edit" asp-route-id="@p.Id">@p.Name</a> @if (p.IsFeatured) { <span class="badge text-bg-info">Destaque</span> }</td>
                <td class="small">@p.Sku</td>
                <td class="small">@p.Category?.Name</td>
                <td class="text-end">@if (p.PromotionalPrice.HasValue) { <del class="text-muted small">@p.Price.ToBrl()</del> <br /> @p.PromotionalPrice.ToBrl() } else { @p.Price.ToBrl() }</td>
                <td class="text-end"><span class="badge text-bg-@(p.StockQuantity <= 0 ? "danger" : "light text-dark")">@p.StockQuantity</span></td>
                <td>@if (p.IsActive) { <span class="badge text-bg-success">Ativo</span> } else { <span class="badge text-bg-secondary">Inativo</span> }</td>
                <td class="text-end text-nowrap">
                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@p.Id">Editar</a>
                    <form asp-action="Toggle" asp-route-id="@p.Id" method="post" class="d-inline">
                        <button class="btn btn-sm btn-outline-secondary">@(p.IsActive ? "Desativar" : "Ativar")</button>
                    </form>
                </td>
            </tr>
        }
        @if (Model.Items.Count == 0) { <tr><td colspan="8" class="text-center text-muted py-4">Nenhum produto encontrado.</td></tr> }
        </tbody>
    </table>
</div>
<div class="mt-3"><partial name="_Pager" model="pager" /></div>
