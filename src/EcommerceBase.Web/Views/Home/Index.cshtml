@model HomeVm

@{
    ViewData["Title"] = "Início";

    var showcases = new List<(string Title, List<ProductCardVm> Items, string Link)>
    {
        ("Destaques", Model.Featured, "/produtos"),
        ("Mais vendidos", Model.BestSellers, "/produtos"),
        ("Lançamentos", Model.Newest, "/produtos?sort=newest"),
        ("Ofertas", Model.Offers, "/produtos?sort=price_asc")
    };
}

<div class="home-page">

    @* BANNERS PRINCIPAIS *@
    @if (Model.Banners.Count > 0)
    {
        <section class="home-hero" aria-label="Banners em destaque">

            <div id="homeBanners"
                 class="carousel slide home-carousel"
                 data-bs-ride="carousel">

                @if (Model.Banners.Count > 1)
                {
                    <div class="carousel-indicators">
                        @for (var i = 0; i < Model.Banners.Count; i++)
                        {
                            <button type="button"
                                    data-bs-target="#homeBanners"
                                    data-bs-slide-to="@i"
                                    class="@(i == 0 ? "active" : "")"
                                    aria-current="@(i == 0 ? "true" : "false")"
                                    aria-label="Banner @(i + 1)">
                            </button>
                        }
                    </div>
                }

                <div class="carousel-inner">
                    @for (var i = 0; i < Model.Banners.Count; i++)
                    {
                        var banner = Model.Banners[i];

                        var validLink =
                            !string.IsNullOrWhiteSpace(banner.LinkUrl) &&
                            (banner.LinkUrl.StartsWith("/") ||
                             banner.LinkUrl.StartsWith("https://",
                                 StringComparison.OrdinalIgnoreCase));

                        <div class="carousel-item @(i == 0 ? "active" : "")">

                            <div class="hero-banner">

                                @if (validLink)
                                {
                                    <a class="hero-banner-image-link"
                                       href="@banner.LinkUrl"
                                       aria-label="@banner.Title">

                                        <img src="@banner.ImagePath"
                                             alt="@banner.Title"
                                             class="hero-banner-image"
                                             loading="@(i == 0 ? "eager" : "lazy")" />
                                    </a>
                                }
                                else
                                {
                                    <img src="@banner.ImagePath"
                                         alt="@banner.Title"
                                         class="hero-banner-image"
                                         loading="@(i == 0 ? "eager" : "lazy")" />
                                }

                                <div class="hero-overlay"></div>

                                <div class="hero-caption">
                                    <span class="hero-eyebrow">
                                        PORTALGAMERX
                                    </span>

                                    <h1>@banner.Title</h1>

                                    @if (!string.IsNullOrWhiteSpace(banner.Subtitle))
                                    {
                                        <p>@banner.Subtitle</p>
                                    }

                                    @if (validLink &&
                                         !string.IsNullOrWhiteSpace(banner.ButtonText))
                                    {
                                        <a class="btn-home-primary"
                                           href="@banner.LinkUrl">
                                            @banner.ButtonText
                                            <span aria-hidden="true">→</span>
                                        </a>
                                    }
                                </div>

                            </div>
                        </div>
                    }
                </div>

                @if (Model.Banners.Count > 1)
                {
                    <button class="carousel-control-prev home-carousel-control"
                            type="button"
                            data-bs-target="#homeBanners"
                            data-bs-slide="prev"
                            aria-label="Banner anterior">

                        <span class="carousel-control-prev-icon"
                              aria-hidden="true"></span>

                        <span class="visually-hidden">Anterior</span>
                    </button>

                    <button class="carousel-control-next home-carousel-control"
                            type="button"
                            data-bs-target="#homeBanners"
                            data-bs-slide="next"
                            aria-label="Próximo banner">

                        <span class="carousel-control-next-icon"
                              aria-hidden="true"></span>

                        <span class="visually-hidden">Próximo</span>
                    </button>
                }

            </div>
        </section>
    }

    @* CATEGORIAS *@
    @if (Model.Categories.Count > 0)
    {
        <section class="home-categories" aria-label="Categorias de produtos">

            <div class="home-section-heading">
                <div>
                    <span class="home-section-eyebrow">EXPLORE</span>
                    <h2 class="section-title">Navegue por categorias</h2>
                </div>
            </div>

            <div class="home-category-list">
                @foreach (var category in Model.Categories)
                {
                    <a class="category-chip"
                       href="/categoria/@category.Slug">

                        <span class="category-chip-indicator"
                              aria-hidden="true"></span>

                        <span>@category.Name</span>

                        <span class="category-chip-arrow"
                              aria-hidden="true">→</span>
                    </a>
                }
            </div>

        </section>
    }

    @* ESTADO VAZIO *@
    @if (Model.IsEmpty)
    {
        <section class="home-empty-state">

            <div class="empty-state-icon" aria-hidden="true">
                <span></span>
                <span></span>
                <span></span>
            </div>

            <span class="home-section-eyebrow">EM CONSTRUÇÃO</span>

            <h2>Nossa loja está sendo preparada</h2>

            <p>
                Estamos preparando o portal para você.
                Em breve, novidades e produtos estarão disponíveis.
            </p>

            <a href="/produtos" class="btn-home-secondary">
                Explorar produtos
                <span aria-hidden="true">→</span>
            </a>

        </section>
    }

    @* VITRINES DE PRODUTOS *@
    @foreach (var showcase in showcases)
    {
        var title = showcase.Title;
        var items = showcase.Items;
        var link = showcase.Link;

        if (items.Count == 0)
        {
            continue;
        }

        <section class="home-showcase">

            <div class="home-section-heading">

                <div class="home-section-heading-title">
                    <span class="home-section-eyebrow">
                        PORTALGAMERX
                    </span>

                    <h2 class="section-title">@title</h2>
                </div>

                <a href="@link" class="home-view-all">
                    Ver todos
                    <span aria-hidden="true">→</span>
                </a>

            </div>

            <div class="home-product-grid">
                @foreach (var product in items)
                {
                    <div class="home-product-item">
                        <partial name="_ProductCard" model="product" />
                    </div>
                }
            </div>

        </section>
    }

</div>
