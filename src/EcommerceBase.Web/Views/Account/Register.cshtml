@model RegisterVm
@{
    ViewData["Title"] = "Criar conta";
}
<div class="card auth-card shadow-sm">
    <div class="card-body">
        <h1 class="h4 mb-3">Criar conta</h1>
        <form asp-antiforgery="true" method="post" action="/conta/cadastro">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="FullName" class="form-label"></label>
                <input asp-for="FullName" class="form-control" autocomplete="name" />
                <span asp-validation-for="FullName" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" autocomplete="email" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Document" class="form-label"></label>
                    <input asp-for="Document" class="form-control" inputmode="numeric" />
                    <span asp-validation-for="Document" class="text-danger small"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Phone" class="form-label"></label>
                    <input asp-for="Phone" class="form-control" autocomplete="tel" />
                    <span asp-validation-for="Phone" class="text-danger small"></span>
                </div>
            </div>
            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" autocomplete="new-password" />
                <div class="form-text">Mínimo de 8 caracteres, com maiúscula, minúscula e número.</div>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>
            <div class="form-check mb-3">
                <input asp-for="AcceptTerms" class="form-check-input" />
                <label asp-for="AcceptTerms" class="form-check-label"></label>
                (<a href="/politicas/termos" target="_blank" rel="noopener">termos</a> · <a href="/politicas/privacidade" target="_blank" rel="noopener">privacidade</a>)
                <div><span asp-validation-for="AcceptTerms" class="text-danger small"></span></div>
            </div>
            <button type="submit" class="btn btn-brand w-100">Criar conta</button>
        </form>
        <div class="mt-3 small">Já tem conta? <a href="/conta/entrar">Entrar</a></div>
    </div>
</div>
