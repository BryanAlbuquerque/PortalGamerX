@model ForgotPasswordVm
@{
    ViewData["Title"] = "Esqueci minha senha";
}
<div class="card auth-card shadow-sm"><div class="card-body">
    <h1 class="h4 mb-3">Recuperar senha</h1>
    <form asp-antiforgery="true" method="post" action="/conta/esqueci-senha">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="mb-3">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" />
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>
        <button type="submit" class="btn btn-brand w-100">Enviar link de redefinição</button>
    </form>
</div></div>
