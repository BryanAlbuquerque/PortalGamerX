@model bool
@{
    ViewData["Title"] = "Confirmação de e-mail";
}
<div class="card auth-card shadow-sm"><div class="card-body">
    @if (Model)
    {
        <h1 class="h4 text-success">E-mail confirmado</h1>
        <p>Sua conta está ativa. Você já pode entrar.</p>
        <a class="btn btn-brand" href="/conta/entrar">Entrar</a>
    }
    else
    {
        <h1 class="h4 text-danger">Link inválido ou expirado</h1>
        <p>Não foi possível confirmar o e-mail. <a href="/conta/reenviar-confirmacao">Solicite um novo link</a>.</p>
    }
</div></div>
