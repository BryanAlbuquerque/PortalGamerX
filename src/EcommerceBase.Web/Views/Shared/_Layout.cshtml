@inject IStoreSettingsService StoreSettingsService
@{
    var s = await StoreSettingsService.GetAsync();
    string SafeColor(string? c, string d) => System.Text.RegularExpressions.Regex.IsMatch(c ?? "", "^#[0-9a-fA-F]{6}$") ? c! : d;
    var title = ViewData["Title"] as string;
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(string.IsNullOrEmpty(title) ? s.StoreName : title + " - " + s.StoreName)</title>
    @if (!string.IsNullOrEmpty(s.FaviconPath))
    {
        <link rel="icon" href="@s.FaviconPath" />
    }
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <style>
        :root {
            --brand: @SafeColor(s.PrimaryColor, "#0d6efd");
            --brand-dark: @SafeColor(s.SecondaryColor, "#212529");
            --accent: @SafeColor(s.AccentColor, "#ff6b35");
        }
    </style>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
<header class="site-header shadow-sm">
    <div class="container py-2 d-flex flex-wrap align-items-center gap-3">
        <a class="navbar-brand fw-bold fs-4 text-decoration-none" href="/">
            @if (!string.IsNullOrEmpty(s.LogoPath))
            {
                <img src="@s.LogoPath" alt="@s.StoreName" class="site-logo" />
            }
            else
            {
                <span>@s.StoreName</span>
            }
        </a>
        <form class="flex-grow-1 search-form" method="get" action="/produtos" role="search">
            <div class="input-group">
                <input type="search" name="q" class="form-control" placeholder="Buscar produtos" aria-label="Buscar produtos" maxlength="100" />
                <button class="btn btn-brand" type="submit">Buscar</button>
            </div>
        </form>
        <div class="d-flex align-items-center gap-2">
            @if (User.Identity?.IsAuthenticated == true)
            {
                @if (User.IsInRole(Roles.Admin))
                {
                    <a class="btn btn-accent fw-bold" href="/admin">PAINEL ADMIN</a>
                }
                <div class="dropdown">
                    <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">Minha conta</button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item" href="/conta">Resumo</a></li>
                        <li><a class="dropdown-item" href="/conta/pedidos">Meus pedidos</a></li>
                        <li><a class="dropdown-item" href="/conta/enderecos">Endereços</a></li>
                        <li><a class="dropdown-item" href="/conta/perfil">Meus dados</a></li>
                        <li><hr class="dropdown-divider" /></li>
                        <li>
                            <form method="post" action="/conta/sair" class="px-3">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-link p-0 text-decoration-none">Sair</button>
                            </form>
                        </li>
                    </ul>
                </div>
            }
            else
            {
                <a class="btn btn-outline-secondary" href="/conta/entrar">Entrar</a>
                <a class="btn btn-brand" href="/conta/cadastro">Criar conta</a>
            }
            @await Component.InvokeAsync("CartBadge")
        </div>
    </div>
    <nav class="navbar navbar-expand-lg site-nav">
        <div class="container">
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Menu">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav">
                    <li class="nav-item"><a class="nav-link" href="/">Início</a></li>
                    <li class="nav-item"><a class="nav-link" href="/produtos">Todos os produtos</a></li>
                    <li class="nav-item"><a class="nav-link" href="/produtos?sort=newest">Lançamentos</a></li>
                    @await Component.InvokeAsync("NavCategories")
                    <li class="nav-item"><a class="nav-link" href="/sobre">Sobre</a></li>
                </ul>
            </div>
        </div>
    </nav>
</header>

<main class="container my-4 flex-grow-1">
    <partial name="_Alerts" />
    @RenderBody()
</main>

<footer class="site-footer mt-auto">
    <div class="container py-4">
        <div class="row g-4">
            <div class="col-md-4">
                <h6>@s.StoreName</h6>
                @if (!string.IsNullOrWhiteSpace(s.FooterText))
                {
                    <p class="small text-pre">@s.FooterText</p>
                }
            </div>
            <div class="col-md-4">
                <h6>Atendimento</h6>
                <ul class="list-unstyled small">
                    @if (!string.IsNullOrWhiteSpace(s.Email)) { <li>@s.Email</li> }
                    @if (!string.IsNullOrWhiteSpace(s.Phone)) { <li>@s.Phone</li> }
                    @if (!string.IsNullOrWhiteSpace(s.SupportInfo)) { <li class="text-pre">@s.SupportInfo</li> }
                    @if (!string.IsNullOrWhiteSpace(s.City)) { <li>@s.City@(string.IsNullOrWhiteSpace(s.State) ? "" : " - " + s.State)</li> }
                </ul>
            </div>
            <div class="col-md-4">
                <h6>Informações</h6>
                <ul class="list-unstyled small">
                    <li><a href="/sobre">Sobre nós</a></li>
                    <li><a href="/politicas/entrega">Política de entrega</a></li>
                    <li><a href="/politicas/trocas">Trocas e devoluções</a></li>
                    <li><a href="/politicas/privacidade">Privacidade</a></li>
                    <li><a href="/politicas/termos">Termos de uso</a></li>
                </ul>
            </div>
        </div>
        <hr />
        <p class="small mb-0">
            © @DateTime.UtcNow.Year @(string.IsNullOrWhiteSpace(s.TradeName) ? s.StoreName : s.TradeName)
            @if (!string.IsNullOrWhiteSpace(s.LegalName)) { <text> - @s.LegalName</text> }
            @if (!string.IsNullOrWhiteSpace(s.Cnpj)) { <text> - CNPJ @s.Cnpj</text> }
        </p>
    </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
