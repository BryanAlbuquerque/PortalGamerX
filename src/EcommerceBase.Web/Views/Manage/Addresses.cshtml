@model List<Address>
@{
    ViewData["Title"] = "Endereços";
}
<div class="row">
    <div class="col-md-3"><partial name="_Nav" /></div>
    <div class="col-md-9">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h1 class="h4 mb-0">Meus endereços</h1>
            <a class="btn btn-brand btn-sm" href="/conta/enderecos/novo">Novo endereço</a>
        </div>
        @if (Model.Count == 0)
        {
            <div class="alert alert-light border">Nenhum endereço cadastrado.</div>
        }
        <div class="row g-3">
            @foreach (var a in Model)
            {
                <div class="col-md-6">
                    <div class="card h-100"><div class="card-body">
                        <h6>@a.Label @if (a.IsDefault) { <span class="badge bg-success">Principal</span> }</h6>
                        <div class="small">
                            @a.RecipientName<br />
                            @a.Street, @a.Number@(string.IsNullOrWhiteSpace(a.Complement) ? "" : " - " + a.Complement)<br />
                            @a.District · @a.City/@a.State<br />
                            CEP @Documents.FormatPostalCode(a.PostalCode)
                        </div>
                    </div>
                    <div class="card-footer d-flex gap-2 flex-wrap">
                        <a class="btn btn-outline-secondary btn-sm" href="/conta/enderecos/@a.Id/editar">Editar</a>
                        @if (!a.IsDefault)
                        {
                            <form asp-antiforgery="true" method="post" action="/conta/enderecos/@a.Id/principal"><button class="btn btn-outline-secondary btn-sm" type="submit">Tornar principal</button></form>
                        }
                        <form asp-antiforgery="true" method="post" action="/conta/enderecos/@a.Id/excluir" data-confirm="Remover este endereço?"><button class="btn btn-outline-danger btn-sm" type="submit">Excluir</button></form>
                    </div></div>
                </div>
            }
        </div>
    </div>
</div>
