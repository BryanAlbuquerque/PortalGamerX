@{
    var current = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    string Active(params string[] names) => names.Contains(current) ? "active" : "";
}
<div class="list-group mb-3">
    <a class="list-group-item list-group-item-action @Active("Index")" href="/conta">Resumo</a>
    <a class="list-group-item list-group-item-action @Active("Orders", "OrderDetails")" href="/conta/pedidos">Meus pedidos</a>
    <a class="list-group-item list-group-item-action @Active("Addresses", "AddressCreate", "AddressEdit", "AddressSave")" href="/conta/enderecos">Endereços</a>
    <a class="list-group-item list-group-item-action @Active("Profile")" href="/conta/perfil">Meus dados</a>
    <a class="list-group-item list-group-item-action @Active("ChangePassword")" href="/conta/senha">Alterar senha</a>
    @if (User.IsInRole(Roles.Admin))
    {
        <a class="list-group-item list-group-item-action" href="/admin/settings">Configurações da loja</a>
    }
</div>
