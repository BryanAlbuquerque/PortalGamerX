# ===== Ecommerce Base - variáveis de ambiente (modelo, SEM valores secretos) =====
# Copie para .env (NÃO versionar) ou configure no painel do Render.

ASPNETCORE_ENVIRONMENT=Production

# Banco de dados (use UMA das opções)
# 1) URL no formato do Render:
DATABASE_URL=postgres://USUARIO:SENHA@HOST:5432/NOME_DO_BANCO
# 2) ou string Npgsql:
# ConnectionStrings__Default=Host=localhost;Port=5432;Database=ecommercebase;Username=postgres;Password=SUA_SENHA
# Modo SSL (Disable|Prefer|Require). Conexão interna do Render: Prefer. Externa: Require.
DATABASE_SSLMODE=Prefer

# URL pública da loja (https, sem barra final). Usada em links de e-mail, retorno e webhooks.
App__PublicBaseUrl=https://sua-loja.onrender.com

# Armazenamento de imagens (aponte para o disco persistente do Render, ex.: /var/data)
Storage__RootPath=/var/data/storage

# Migrations automáticas na inicialização (false por padrão em produção)
Database__MigrateOnStartup=false

# Primeiro administrador (bootstrap): só cria se NÃO existir nenhum Admin. Remova a senha depois.
Bootstrap__AdminEmail=
Bootstrap__AdminPassword=
Bootstrap__AdminName=Administrador

# Identity
Identity__RequireConfirmedEmail=true

# Necessário atrás do proxy do Render (já definido no Dockerfile)
ASPNETCORE_FORWARDEDHEADERS_ENABLED=true
